.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.temp 87.77303331297907

vsupply vdd 0 DC 0.8422082664615785
vin_a a 0 DC 0.8422082664615785
vin_b b 0 DC 0.8422082664615785

* M<name> d g s b, each terminal through a 0 V ammeter v<name>_<terminal>
mp1 mp1_d mp1_g mp1_s mp1_b pch W=2.2e-08 L=2.2e-08
vmp1_d out mp1_d DC 0
vmp1_g a mp1_g DC 0
vmp1_s vdd mp1_s DC 0
vmp1_b vdd mp1_b DC 0
mp2 mp2_d mp2_g mp2_s mp2_b pch W=2.2e-08 L=2.2e-08
vmp2_d out mp2_d DC 0
vmp2_g b mp2_g DC 0
vmp2_s vdd mp2_s DC 0
vmp2_b vdd mp2_b DC 0
mn1 mn1_d mn1_g mn1_s mn1_b nch W=2.2e-08 L=2.2e-08
vmn1_d out mn1_d DC 0
vmn1_g a mn1_g DC 0
vmn1_s x mn1_s DC 0
vmn1_b 0 mn1_b DC 0
mn2 mn2_d mn2_g mn2_s mn2_b nch W=2.2e-08 L=2.2e-08
vmn2_d x mn2_d DC 0
vmn2_g b mn2_g DC 0
vmn2_s 0 mn2_s DC 0
vmn2_b 0 mn2_b DC 0

.control
set numdgt=15
op
let i_supply = -i(vsupply)
let i_in_a = -i(vin_a)
let i_in_b = -i(vin_b)
let v_out = v(out)
let v_x = v(x)
let mp1_id = i(vmp1_d)
let mp1_ig = i(vmp1_g)
let mp1_is = i(vmp1_s)
let mp1_ib = i(vmp1_b)
let mp2_id = i(vmp2_d)
let mp2_ig = i(vmp2_g)
let mp2_is = i(vmp2_s)
let mp2_ib = i(vmp2_b)
let mn1_id = i(vmn1_d)
let mn1_ig = i(vmn1_g)
let mn1_is = i(vmn1_s)
let mn1_ib = i(vmn1_b)
let mn2_id = i(vmn2_d)
let mn2_ig = i(vmn2_g)
let mn2_is = i(vmn2_s)
let mn2_ib = i(vmn2_b)
print i_supply
print i_in_a
print i_in_b
print v_out
print v_x
print mp1_id
print mp1_ig
print mp1_is
print mp1_ib
print mp2_id
print mp2_ig
print mp2_is
print mp2_ib
print mn1_id
print mn1_ig
print mn1_is
print mn1_ib
print mn2_id
print mn2_ig
print mn2_is
print mn2_ib
.endc

.end
