* NMOS OFF - single transistor, 22nm MGK, nominal corner (Vg = 0, Vb = 0)

.include ../../models/22nm_MGK.pm

.options gmin=1e-18 abstol=1e-18 reltol=1e-6 vntol=1e-9
.temp 27

* Transistor: M<name> drain gate source body model W L AD AS (AD = AS = W x 2 Lmin)
M1 d g s b nmos W=44n L=22n AD=1.936e-15 AS=1.936e-15

* One DC source per terminal (VDD = 0.9 V)
Vd d 0 DC 0.9
Vg g 0 DC 0
Vs s 0 DC 0
Vb b 0 DC 0

.control
op
* -i(Vx) = current flowing INTO terminal x of the transistor
let id = -i(Vd)
let ig = -i(Vg)
let is = -i(Vs)
let ib = -i(Vb)
let kcl = id + ig + is + ib
print id ig is ib kcl
.endc

.end
